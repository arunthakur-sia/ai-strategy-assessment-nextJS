# ── Next.js App Config ────────────────────────────────────────────────────────
# Session signing secret (generate with: openssl rand -hex 32)
SESSION_SECRET=change-me-to-a-random-32-char-string

NODE_ENV=development

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Set to "true" to use local file-based storage instead of Supabase
# LOCAL_DB=true

# ── SiaGPT (AI Backend - Claude) ──────────────────────────────────────────────
SIAGPT_BASE_URL=https://backend.siagpt.ai
SIAGPT_PROJECT_ID=your-project-uuid
SIAGPT_MEDIA_FOLDER_ID=your-media-folder-uuid
SIAGPT_OWNER_ID=your-owner-uuid

# Optional: appended to every SiaGPT message payload when set (SiaGPT-specific bundling)
# SIAGPT_BUNDLE_ID=

# Optional: generic fallback agent used only when no per-task assistant ID is provided.
# In practice this is never hit if all SIAGPT_ASSISTANT_* vars below are filled in.
# SIAGPT_ASSISTANT_ID=

# Per-pillar SiaGPT agent IDs
SIAGPT_ASSISTANT_P1=
SIAGPT_ASSISTANT_P2=
SIAGPT_ASSISTANT_P3=
SIAGPT_ASSISTANT_P4=
SIAGPT_ASSISTANT_P5=
SIAGPT_ASSISTANT_P6=
SIAGPT_ASSISTANT_P7=
SIAGPT_ASSISTANT_P8=

# Non-pillar agents
SIAGPT_ASSISTANT_SWOT=
SIAGPT_ASSISTANT_STRATEGY=
SIAGPT_ASSISTANT_CHAT=
SIAGPT_ASSISTANT_D1=
SIAGPT_ASSISTANT_D2=
SIAGPT_ASSISTANT_D3=
SIAGPT_ASSISTANT_D4=
SIAGPT_ASSISTANT_D5=
SIAGPT_ASSISTANT_D6=

# ── OAuth2 (Zitadel — used to get SiaGPT access tokens) ──────────────────────
OAUTH2_TOKEN_URL=https://your-zitadel-instance.com/oauth/v2/token
OAUTH2_CLIENT_ID=your-client-id
OAUTH2_CLIENT_SECRET=your-client-secret
ZITADEL_PROJECT_ID=your-zitadel-project-id

# Dev-only shortcut: static bearer token (skips OAuth2 entirely)
# SIAGPT_BEARER_TOKEN=your-static-token

# ── CORS (optional — not needed for same-origin Next.js deployment) ───────────
# CORS_ORIGINS=https://your-frontend.vercel.app

# ── App Name ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=SIA Strategy Assessment Agent
