# ── Server ──────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# Random string, minimum 32 characters
SESSION_SECRET=change-this-to-a-long-random-secret-string

# ── Supabase (Database) ──────────────────────────────────────────
# Get from: https://app.supabase.com → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── SiaGPT (AI — Claude via SiaGPT backend) ─────────────────────
# AI is powered by SiaGPT with Claude. Omit OAuth2 credentials to run in demo mode.
SIAGPT_BASE_URL=https://backend.siagpt.ai
SIAGPT_PROJECT_ID=your-siagpt-project-uuid
SIAGPT_BUNDLE_ID=your-bundle-uuid
SIAGPT_ASSISTANT_ID=your-assistant-uuid

# OAuth2 / Zitadel authentication for SiaGPT
OAUTH2_TOKEN_URL=
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=
ZITADEL_PROJECT_ID=

# Static Bearer Token — overrides OAuth2 if set (development only)
SIAGPT_BEARER_TOKEN=

# Collections & Media (required for collections/media features)
SIAGPT_MEDIA_FOLDER_ID=your-media-folder-uuid

# ── CORS ─────────────────────────────────────────────────────────
# URL of your deployed frontend (no trailing slash)
FRONTEND_URL=http://localhost:5173
