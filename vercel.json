{
  "framework": "nextjs",
  "functions": {
    "app/api/ai/[projectId]/generate-reports-batch/route.ts": { "maxDuration": 800 },
    "app/api/ai/[projectId]/assess-entities/route.ts": { "maxDuration": 800 },
    "app/api/ai/[projectId]/assess-batch/route.ts": { "maxDuration": 800 },
    "app/api/ai/[projectId]/[entityId]/assess-batch/route.ts": { "maxDuration": 800 },
    "app/api/ai/**/*.ts": { "maxDuration": 720 },
    "app/api/export/**/*.ts": { "maxDuration": 60 },
    "app/api/documents/**/*.ts": { "maxDuration": 120 },
    "app/api/projects/**/*.ts": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}
