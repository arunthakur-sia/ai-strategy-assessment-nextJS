{
  "framework": "nextjs",
  "functions": {
    "app/api/ai/**/*.ts": { "maxDuration": 300 },
    "app/api/export/**/*.ts": { "maxDuration": 60 },
    "app/api/projects/**/*.ts": { "maxDuration": 60 },
    "app/api/documents/**/*.ts": { "maxDuration": 120 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}
